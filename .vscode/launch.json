{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Build: @reporting/core",
      "type": "node",
      "request": "launch",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "build", "-w", "@reporting/core"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal"
    },
    {
      "name": "Build: @reporting/core (watch)",
      "type": "node",
      "request": "launch",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "build:watch", "-w", "@reporting/core"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal"
    },
    {
      "name": "Build: @reporting/react-ui (watch)",
      "type": "node",
      "request": "launch",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "build:watch", "-w", "@reporting/react-ui"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal"
    },
    {
      "name": "Storybook: Start dev server",
      "type": "node",
      "request": "launch",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "storybook"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal"
    },
    {
      "name": "Storybook: Open in Chrome",
      "type": "chrome",
      "request": "launch",
      "url": "http://localhost:6006",
      "webRoot": "${workspaceFolder}/apps/storybook"
    },
    {
      "name": "Storybook: Attach to Chrome",
      "type": "chrome",
      "request": "attach",
      "port": 9222,
      "webRoot": "${workspaceFolder}/apps/storybook"
    },
    {
      "name": "MCP Server",
      "type": "node",
      "request": "launch",
      "program": "${workspaceFolder}/packages/mcp-server/dist/index.js",
      "cwd": "${workspaceFolder}/packages/mcp-server",
      "console": "integratedTerminal",
      "envFile": "${workspaceFolder}/packages/mcp-server/.env",
      "preLaunchTask": "build-mcp-server"
    }
  ],
  "compounds": [
    {
      "name": "Storybook: Server + Chrome",
      "configurations": ["Storybook: Start dev server", "Storybook: Open in Chrome"],
      "stopAll": true
    }
  ]
}
