{
  "name": "@reporting/mcp-server",
  "version": "0.1.0-beta.0",
  "description": "MCP server for Prism Reporting tools, resources, and query metadata discovery.",
  "type": "module",
  "bin": {
    "reporting-mcp": "./dist/index.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "author": {
    "name": "Sargis Markosyan",
    "email": "sargismarkosyan5@gmail.com",
    "url": "https://www.linkedin.com/in/sargismarkosyan/"
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/Prism-Reporting/reporting.git",
    "directory": "packages/mcp-server"
  },
  "bugs": {
    "url": "https://github.com/Prism-Reporting/reporting/issues"
  },
  "homepage": "https://github.com/Prism-Reporting/reporting/tree/main/packages/mcp-server",
  "publishConfig": {
    "access": "public",
    "tag": "beta"
  },
  "exports": {
    ".": { "types": "./dist/index.d.ts", "default": "./dist/index.js" },
    "./http": { "types": "./dist/http.d.ts", "default": "./dist/http.js" },
    "./schemas": { "types": "./dist/schemas.d.ts", "default": "./dist/schemas.js" },
    "./build-report-tool": { "types": "./dist/build-report-tool.d.ts", "default": "./dist/build-report-tool.js" },
    "./contract": { "types": "./dist/contract.d.ts", "default": "./dist/contract.js" },
    "./format-report-spec": { "types": "./dist/format-report-spec.d.ts", "default": "./dist/format-report-spec.js" }
  },
  "scripts": {
    "build": "tsc",
    "build:watch": "tsc --watch",
    "start": "node dist/index.js",
    "test": "pnpm build && node --test test/*.test.js"
  },
  "dependencies": {
    "@reporting/core": "workspace:^",
    "@modelcontextprotocol/sdk": "^1.0.0",
    "zod": "^3.23.0"
  },
  "keywords": [
    "reporting",
    "mcp",
    "ai",
    "server"
  ],
  "devDependencies": {
    "@types/node": "^20.0.0",
    "typescript": "^5.3.3"
  },
  "engines": {
    "node": ">=18"
  }
}
