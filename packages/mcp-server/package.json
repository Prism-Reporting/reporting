{
  "name": "@reporting/mcp-server",
  "version": "0.1.0",
  "type": "module",
  "bin": {
    "reporting-mcp": "./dist/index.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": { "types": "./dist/index.d.ts", "default": "./dist/index.js" },
    "./http": { "types": "./dist/http.d.ts", "default": "./dist/http.js" },
    "./schemas": { "types": "./dist/schemas.d.ts", "default": "./dist/schemas.js" },
    "./build-report-tool": { "types": "./dist/build-report-tool.d.ts", "default": "./dist/build-report-tool.js" },
    "./format-report-spec": { "types": "./dist/format-report-spec.d.ts", "default": "./dist/format-report-spec.js" }
  },
  "scripts": {
    "build": "tsc",
    "build:watch": "tsc --watch",
    "start": "node dist/index.js",
    "test": "npm run build && node --test test/*.test.js"
  },
  "dependencies": {
    "@reporting/core": "*",
    "@modelcontextprotocol/sdk": "^1.0.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "typescript": "^5.3.3"
  },
  "engines": {
    "node": ">=18"
  }
}
