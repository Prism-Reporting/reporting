{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "baseUrl": ".",
    "lib": ["ES2020"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "paths": {
      "@prism-reporting/core": ["packages/core/dist/index.d.ts"],
      "@prism-reporting/agent-kit": ["packages/agent-kit/dist/index.d.ts"],
      "@prism-reporting/react-ui": ["packages/react-ui/dist/index.d.ts"],
      "@prism-reporting/mcp-server": ["packages/mcp-server/dist/index.d.ts"],
      "@prism-reporting/mcp-server/*": ["packages/mcp-server/dist/*"]
    },
    "declaration": true,
    "declarationMap": true,
    "noEmit": false
  },
  "exclude": ["node_modules", "dist"]
}
